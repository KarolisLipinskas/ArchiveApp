<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Custom "Tabs" scrollbar style -->
    <Style Selector=".tab-scroll ScrollBar">
        <Setter Property="AllowAutoHide" Value="False"></Setter>
        
        <Style Selector="^ /template/ Grid">
            <Setter Property="MaxHeight" Value="10"></Setter>
            <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
        </Style>
        <Style Selector="^ /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="Transparent"></Setter>
        </Style>
        <Style Selector="^ RepeatButton">
            <Setter Property="IsVisible" Value="False"></Setter>
        </Style>
        <Style Selector="^ Thumb">
            <Setter Property="MaxHeight" Value="10"></Setter>
            <Setter Property="Opacity" Value="0.5"></Setter>
            <Setter Property="CornerRadius" Value="50"></Setter>
        </Style>
        <Style Selector="^ Thumb:pointerover">
            <Setter Property="Opacity" Value="1"></Setter>
        </Style>
        <Style Selector="^ Thumb:pressed">
            <Setter Property="Opacity" Value="1"></Setter>
        </Style>
    </Style>
</Styles>
